generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  ACCOUNTANT
  WORKSHOP
  COURIER
  /// Кассир: добавляет и убирает товары, ставит фото и розничные цены
  CASHIER
  PARTNER
  GUEST
  CLIENT
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum OrderStatus {
  NEW
  APPROVED
  PAID
  IN_PRODUCTION
  READY
  SHIPPED
  DELIVERED
  REJECTED
  CANCELLED
}

enum OtpPurpose {
  LOGIN
  REGISTER
  CHANGE_PHONE
}

enum OneCDocType {
  CUSTOMER_ORDER // «Заказ клиента» — при подтверждении оплаты: товар списывается/резервируется в 1С
  PRODUCTION // «Заказ на производство» — по сводной накладной
  SALE // «Реализация товаров и услуг» — при отгрузке или выдаче гостю
  CANCEL // Отмена подтверждённого заказа — 1С возвращает товар
}

/// Откуда заказ: партнёр (опт, доставка) или гость кофейни (самовывоз из филиала)
enum OrderChannel {
  PARTNER
  CAFE
}

enum OneCDocStatus {
  PENDING
  SENT
  ERROR
}

/// Любой, кто входит в приложение или веб-панель: сотрудник, партнёр, гость.
model User {
  id             String     @id @default(cuid())
  phone          String?    @unique
  login          String?    @unique
  passwordHash   String?
  name           String
  email          String?
  role           Role
  status         UserStatus @default(ACTIVE)
  /// Срок действия доступа (гости и временные учётки)
  accessExpiresAt DateTime?
  /// Для гостей: разрешено ли оформлять заказы
  canOrder       Boolean    @default(false)
  /// Увеличивается при блокировке/смене роли — старые токены перестают работать
  tokenVersion   Int        @default(0)
  partnerId      String?
  partner        Partner?   @relation(fields: [partnerId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  lastLoginAt    DateTime?

  orders        Order[]         @relation("OrderCreatedBy")
  courierOrders Order[]         @relation("OrderCourier")
  pushTokens    PushToken[]
  notifications Notification[]
  audit         AuditLog[]
  statusChanges OrderStatusHistory[]
  positions     CourierPosition[]
  /// Курьер «на линии» — передаёт геопозицию
  onShiftSince  DateTime?
  /// Любимый филиал гостя кофейни
  branchId      String?
  /// Пользователь удалил аккаунт: данные обезличены, вход закрыт
  deletedAt     DateTime?
}

/// Филиал кофейни. Своё меню и цены — через собственный тип цен.
model Branch {
  id          String    @id @default(cuid())
  name        String
  address     String?
  lat         Float?
  lng         Float?
  phone       String?
  /// Часы работы "08:00" — "22:00": по ним строятся слоты брони
  opensAt     String    @default("08:00")
  closesAt    String    @default("22:00")
  priceTypeId String    @unique
  priceType   PriceType @relation(fields: [priceTypeId], references: [id])
  /// Код склада филиала в 1С — откуда списывается товар
  oneCWarehouseId String? @unique
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  orders      Order[]
}

/// Остатки из 1С по складам. Свободный остаток = qty минус подтверждённые заказы, которые 1С ещё не приняла.
model Stock {
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  qty         Decimal  @db.Decimal(12, 3)
  updatedAt   DateTime @updatedAt

  @@id([productId, warehouseId])
}

/// Истории на главной (как в Instagram). Ведут админ и менеджер.
model Story {
  id        String    @id @default(cuid())
  title     String
  caption   String?
  imageUrl  String
  /// Кнопка «Заказать» ведёт на товар
  productId String?
  /// ALL | CAFE | PARTNER — кому показывать
  audience  String    @default("ALL")
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

/// Лавка-партнёр (контрагент). Создаётся заявкой из приложения, одобряется админом.
model Partner {
  id          String        @id @default(cuid())
  name        String
  inn         String?
  contactName String
  phone       String
  email       String?
  status      PartnerStatus @default(PENDING)
  rejectReason String?
  /// Индивидуальный тип цен; если пусто — тип цен по умолчанию
  priceTypeId String?
  priceType   PriceType?    @relation(fields: [priceTypeId], references: [id])
  /// Код контрагента в 1С
  oneCId      String?       @unique
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  approvedAt  DateTime?

  users     User[]
  addresses Address[]
  orders    Order[]
}

model Address {
  id        String   @id @default(cuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  label     String?
  address   String
  /// Точка на карте: ставит партнёр или определяется по адресу (геокодирование)
  lat       Float?
  lng       Float?
  /// Подъезд, этаж, ориентир — для курьера
  entrance  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Category {
  id           String    @id @default(cuid())
  name         String
  /// Производственный участок для сводной накладной (выпечка, кондитерский цех, холодный цех)
  workshopArea String?
  sortOrder    Int       @default(0)
  visible      Boolean   @default(true)
  imageUrl     String?
  oneCId       String?   @unique
  /// Раздел меню кофейни: «Бар», «Кухня»
  section      String?
  /// Напитки из этой категории участвуют в акции «7-й кофе бесплатно»
  promoCoffee  Boolean   @default(false)
  products     Product[]
}

model Product {
  id           String   @id @default(cuid())
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  name         String
  description  String?
  composition  String?
  weight       String?
  shelfLife    String?
  unit         String   @default("шт")
  /// Кратность заказа (например, по 6 шт)
  multiplicity Decimal  @default(1) @db.Decimal(12, 3)
  photoUrl     String?
  visible      Boolean  @default(true)
  isNew        Boolean  @default(false)
  sortOrder    Int      @default(0)
  oneCId       String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  prices     Price[]
  orderItems OrderItem[]
  stocks     Stock[]
}

model PriceType {
  id        String    @id @default(cuid())
  name      String
  isDefault Boolean   @default(false)
  /// Розничные цены для покупателей. Их ведёт кассир, партнёрские — только админ и менеджер.
  isRetail  Boolean   @default(false)
  oneCId    String?   @unique
  prices    Price[]
  partners  Partner[]
  branch    Branch?
}

model Price {
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceTypeId String
  priceType   PriceType @relation(fields: [priceTypeId], references: [id], onDelete: Cascade)
  price       Decimal   @db.Decimal(12, 2)

  @@id([productId, priceTypeId])
}

model Order {
  id              String      @id @default(cuid())
  number          Int         @unique @default(autoincrement())
  channel         OrderChannel @default(PARTNER)
  /// Партнёр — только у оптовых заказов. У брони гостя партнёра нет, покупатель — createdBy.
  partnerId       String?
  partner         Partner?    @relation(fields: [partnerId], references: [id])
  /// Филиал самовывоза (бронь гостя кофейни)
  branchId        String?
  branch          Branch?     @relation(fields: [branchId], references: [id])
  /// Когда гость заберёт бронь
  pickupAt        DateTime?
  /// Скидка по акции и сколько напитков в подарок
  discount        Decimal     @default(0) @db.Decimal(12, 2)
  freeCoffees     Int         @default(0)
  /// Подтверждение админом/менеджером: после него заказ идёт в цех и в 1С
  confirmedAt     DateTime?
  confirmedById   String?
  /// Покупатель сообщил, что оплатил (QR или перевод), и, может быть, приложил чек
  paymentClaimedAt DateTime?
  receiptUrl      String?
  createdById     String
  createdBy       User        @relation("OrderCreatedBy", fields: [createdById], references: [id])
  status          OrderStatus @default(NEW)
  deliveryDate    DateTime    @db.Date
  deliveryAddress String
  comment         String?
  total           Decimal     @db.Decimal(12, 2)
  rejectReason    String?

  /// Способ оплаты: QR | BANK (расчётный счёт) | CASH (наличные). paidAt — когда деньги получены.
  paymentMethod   String?
  paidAt          DateTime?
  paidById        String?

  /// Доставка. Как будет устроен курьер — уточняется; поле оставлено под него.
  courierId       String?
  courier         User?       @relation("OrderCourier", fields: [courierId], references: [id])
  shippedAt       DateTime?
  deliveredAt     DateTime?
  /// Координаты адреса доставки на момент заказа
  deliveryLat     Float?
  deliveryLng     Float?
  deliveryEntrance String?
  /// Код вручения. Больше не используется: курьер вручает заказ без кода. Поле оставлено для старых заказов.
  deliveryCode    String?
  /// Курьер на месте (у двери)
  arrivedAt       DateTime?
  /// Кто принял заказ (имя со слов получателя)
  receivedBy      String?

  productionSheetId String?
  productionSheet   ProductionSheet? @relation(fields: [productionSheetId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     OrderItem[]
  history   OrderStatusHistory[]
  oneCDocs  OneCDocument[]

  @@index([deliveryDate, status])
  @@index([partnerId])
  @@index([channel, status])
  @@index([createdById])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  unit      String
  qty       Decimal @db.Decimal(12, 3)
  price     Decimal @db.Decimal(12, 2)
  sum       Decimal @db.Decimal(12, 2)
  /// Кофе по акции: считается в карту «7-й бесплатно»
  promo     Boolean @default(false)
  /// Сколько штук в подарок
  freeQty   Int     @default(0)
}

model OrderStatusHistory {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  from      OrderStatus?
  to        OrderStatus
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  comment   String?
  createdAt DateTime     @default(now())
}

/// Сводная (консолидированная) накладная для цеха на дату производства.
model ProductionSheet {
  id           String   @id @default(cuid())
  number       Int      @unique @default(autoincrement())
  date         DateTime @db.Date
  /// Дозаказ: заказы, одобренные/оплаченные после формирования основной накладной
  isSupplement Boolean  @default(false)
  createdById  String?
  createdAt    DateTime @default(now())
  orders       Order[]
  oneCDocs     OneCDocument[]

  @@index([date])
}

/// Глобальные настройки (одна строка).
model Settings {
  id            Int      @id @default(1)
  /// Время отсечки приёма заказов на следующий день, "HH:MM"
  cutoffTime    String   @default("16:00")
  minOrderSum   Decimal  @default(0) @db.Decimal(12, 2)
  companyName   String   @default("BULO")
  phone         String?
  email         String?
  address       String?
  workHours     String?
  instagram     String?
  whatsapp      String?
  telegram      String?
  /// Точка выдачи (пекарня) — откуда выезжает курьер
  bakeryLat     Float    @default(42.8746)
  bakeryLng     Float    @default(74.5698)
  /// Оплата по QR: строка QR из банка (стандарт ELQR). Сумму и номер заказа подставляем сами.
  qrPayload     String?
  /// Подставлять сумму в QR (включить после проверки в банковском приложении)
  qrWithAmount  Boolean  @default(false)
  /// Реквизиты для оплаты на расчётный счёт
  bankName      String?
  bankRecipient String?
  bankAccount   String?
  bankBik       String?
  bankInn       String?
  /// Акция «N-й кофе бесплатно»
  promoEnabled  Boolean  @default(true)
  promoEvery    Int      @default(7)
  /// Склад цеха в 1С — откуда списываются партнёрские заказы
  workshopWarehouseId String?
  updatedAt     DateTime @updatedAt
}

/// Геопозиция курьера, пока он на линии. Последняя точка — текущее положение, остальные — трек.
model CourierPosition {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lat       Float
  lng       Float
  accuracy  Float?
  heading   Float?
  /// м/с
  speed     Float?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model OtpCode {
  id        String     @id @default(cuid())
  phone     String
  purpose   OtpPurpose
  codeHash  String
  attempts  Int        @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([phone, purpose])
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  orderId   String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

/// Очередь документов для 1С («исходящие»). 1С забирает их по API или они уходят Excel-выгрузкой.
model OneCDocument {
  id                String        @id @default(cuid())
  type              OneCDocType
  status            OneCDocStatus @default(PENDING)
  orderId           String?
  order             Order?        @relation(fields: [orderId], references: [id])
  productionSheetId String?
  productionSheet   ProductionSheet? @relation(fields: [productionSheetId], references: [id])
  payload           Json
  attempts          Int           @default(0)
  lastError         String?
  /// Номер документа, который вернула 1С
  oneCNumber        String?
  createdAt         DateTime      @default(now())
  sentAt            DateTime?

  @@index([status, type])
}

/// Контрагенты, загруженные из 1С, — админ сопоставляет с ними партнёров.
model OneCCounterparty {
  oneCId    String   @id
  name      String
  inn       String?
  address   String?
  phone     String?
  updatedAt DateTime @updatedAt

  @@index([inn])
}

/// Журнал обмена с 1С: что пришло, что ушло, ошибки.
model OneCSyncLog {
  id        String   @id @default(cuid())
  direction String // IN | OUT
  entity    String
  ok        Boolean
  count     Int      @default(0)
  message   String?
  createdAt DateTime @default(now())
}
