# База данных (docker compose up -d db)
DATABASE_URL=postgresql://bulo:bulo@localhost:5433/bulo

PORT=4000
JWT_SECRET=change-me-in-production
# Публичный адрес API — для ссылок на фото товаров
PUBLIC_URL=http://localhost:4000

# Первый администратор (создаётся сидом)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me
ADMIN_PHONE=+996700000000

# СМС: console — код пишется в лог (для разработки). Реальный шлюз подключается позже.
SMS_PROVIDER=console
# В режиме разработки код из СМС возвращается в ответе API
DEV_RETURN_OTP=true

# Ключ, с которым 1С обращается к API обмена (заголовок X-Api-Key)
ONEC_API_KEY=change-me-1c-key

# HTTP-сервис 1С «Ярос»: если заданы, BULO сам отправляет документы и забирает остатки (см. docs/1c-exchange.md)
ONEC_URL=
ONEC_LOGIN=
ONEC_PASSWORD=

# Часовой пояс пекарни (для времени отсечки заказов)
TZ=Asia/Bishkek
